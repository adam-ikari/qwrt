# Build artifacts
build/
build_*/
build-*/
*.o
*.a
*.so
*.dylib
*.dll

# Generated files
# NOTE: dist/polyfill.js + dist/polyfill.bytecode + src/polyfill_default.c are
# deliberately force-tracked (git add -f) as shipped build artifacts so a
# fresh clone compiles without re-running the polyfill build. The rules below
# only stop *other* output under dist/ from being accidentally added.
dist/
polyfill.js
src/polyfill_default.c.bak

# Node.js
node_modules/
package-lock.json
# but commit the docs site lockfile (CI reproducibility)
!docs/package-lock.json

# IDE / editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# Coverage
coverage/
*.gcov
*.gcda
*.gcno

# Debug / sanitizer
build_asan/
build_check/
*.asan
*.lsan

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
Testing/

# Doxygen output
docs/api/

# Local pi agent config
.pi/

# Agent session artifacts
.workflow/

# Python
__pycache__/
*.pyc
