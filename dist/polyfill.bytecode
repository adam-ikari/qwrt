+=M+;Møfunction sha1Bytes(bytes) {
      function rotl(n, b2) {
        return (n << b2 | n >>> 32 - b2) >>> 0;
      }
      var H = [1732584193, 4023233417, 2562383102, 271733878, 3285377520];
      var ml = bytes.length * 8;
      var msg = new Uint8Array((bytes.length + 8 >> 6 << 6) + 64);
      msg.set(bytes, 0);
      msg[bytes.length] = 128;
      var mlb = ml;
      for (var i = 0; i < 8; i++) {
        msg[msg.length - 1 - i] = mlb & 255;
        mlb = Math.floor(mlb / 256);
      }
      for (var off = 0; off < msg.length; off += 64) {
        var W = new Array(80);
        for (var t = 0; t < 16; t++)
          W[t] = msg[off + 4 * t] << 24 | msg[off + 4 * t + 1] << 16 | msg[off + 4 * t + 2] << 8 | msg[off + 4 * t + 3];
        for (var t = 16; t < 80; t++)
          W[t] = rotl(W[t - 3] ^ W[t - 8] ^ W[t - 14] ^ W[t - 16], 1);
        var a = H[0], b = H[1], c = H[2], d = H[3], e = H[4];
        for (var t = 0; t < 80; t++) {
          var f, k;
          if (t < 20) {
            f = b & c | ~b & d;
            k = 1518500249;
          } else if (t < 40) {
            f = b ^ c ^ d;
            k = 1859775393;
          } else if (t < 60) {
            f = b & c | b & d | c & d;
            k = 2400959708;
          } else {
            f = b ^ c ^ d;
            k = 3395469782;
          }
          var tmp = rotl(a, 5) + f + e + k + W[t] >>> 0;
          e = d;
          d = c;
          c = rotl(b, 30);
          b = a;
          a = tmp;
        }
        H[0] = H[0] + a >>> 0;
        H[1] = H[1] + b >>> 0;
        H[2] = H[2] + c >>> 0;
        H[3] = H[3] + d >>> 0;
        H[4] = H[4] + e >>> 0;
      }
      var out = new Uint8Array(20);
      for (var i = 0; i < 5; i++) {
        out[4 * i] = H[i] >>> 24 & 255;
        out[4 * i + 1] = H[i] >>> 16 & 255;
        out[4 * i + 2] = H[i] >>> 8 & 255;
        out[4 * i + 3] = H[i] & 255;
      }
      return out;
    }C
