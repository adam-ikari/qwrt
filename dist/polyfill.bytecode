      var out = "";
      var i = start, end = start + len;
      while (i < end) {
        var b = u8[i];
        if (b < 128) {
          out += String.fromCharCode(b);
          i += 1;
        } else if (b < 224) {
          out += String.fromCharCode((b & 31) << 6 | u8[i + 1] & 63);
          i += 2;
        } else if (b < 240) {
          out += String.fromCharCode((b & 15) << 12 | (u8[i + 1] & 63) << 6 | u8[i + 2] & 63);
