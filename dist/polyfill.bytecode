        } else {
          var cp = (b & 7) << 18 | (u8[i + 1] & 63) << 12 | (u8[i + 2] & 63) << 6 | u8[i + 3] & 63;
          var u = cp - 65536;
          out += String.fromCharCode(55296 + (u >> 10)) + String.fromCharCode(56320 + (u & 1023));
          i += 4;
        }
      }
      return out;
    }C
