      get CONNECTING() {
        return 0;
      }
      get OPEN() {
        return 1;
      }
      get CLOSED() {
        return 2;
      }
      get url() {
        return this._url;
      }
      get readyState() {
        return this._readyState;
      }
      get withCredentials() {
