      } else if (len < 65536) {
        frame[pos++] = (mask ? 128 : 0) | 126;
        frame[pos++] = len >> 8 & 255;
        frame[pos++] = len & 255;
      } else {
        frame[pos++] = (mask ? 128 : 0) | 127;
        for (var i = 7; i >= 0; i--) frame[pos++] = len >> i * 8 & 255;
      }
      if (mask) {
        var maskKey = new Uint8Array(4);
        crypto.getRandomValues(maskKey);
        frame.set(maskKey, pos);
