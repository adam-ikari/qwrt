    var OPEN = 1;
    var CLOSING = 2;
    var CLOSED = 3;
    var OPCODE_CONT = 0;
    var OPCODE_TEXT = 1;
    var OPCODE_BINARY = 2;
    var OPCODE_CLOSE = 8;
    var OPCODE_PING = 9;
