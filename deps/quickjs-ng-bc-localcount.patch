# qwrt patch: reject bytecode whose VardefsCount (local_count) mismatches arg_count+var_count
# Base submodule: deps/quickjs-ng @ 1ab8676f4b6d6d669baeb5f21790fb9734636a20 (v0.16.2)
# Working-tree-only (the submodule stays clean); CMake re-applies when needed.
# JS_ReadFunctionTag allocates vardefs from the stream local_count while
# free_function_bytecode walks arg_count+var_count of them; the writer always
# emits the two as equal, so a corrupted stream made the free path read heap
# garbage as atoms (__JS_FreeAtom SEGV, caught by the fuzz-smoke job).
diff --git a/quickjs.c b/quickjs.c
index 91661ab..72f0a24 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -39719,16 +39719,25 @@ static JSValue JS_ReadFunctionTag(BCReaderState *s)
     if (bc_get_leb128_u16(s, &bc.closure_var_count))
         goto fail;
     if (bc_get_leb128_int(s, &bc.cpool_count))
         goto fail;
     if (bc_get_leb128_int(s, &bc.byte_code_len))
         goto fail;
     if (bc_get_leb128_int(s, &local_count))
         goto fail;
+    if (local_count != (int)(bc.arg_count + bc.var_count)) {
+        /* qwrt fix: the writer emits this field as arg_count + var_count
+         * ("redundant" per writer comment). Reject mismatch instead of
+         * allocating local_count vardefs while free_function_bytecode()
+         * walks arg_count + var_count of them (fuzzer-found OOB read
+         * in __JS_FreeAtom). */
+        JS_ThrowSyntaxError(ctx, "invalid local count");
+        goto fail;
+    }
 
     function_size = sizeof(*b);
     cpool_offset = (function_size + 7) & ~7;
     function_size = cpool_offset + bc.cpool_count * sizeof(*bc.cpool);
     vardefs_offset = function_size;
     function_size += local_count * sizeof(*bc.vardefs);
     closure_var_offset = function_size;
     function_size += bc.closure_var_count * sizeof(*bc.closure_var);
