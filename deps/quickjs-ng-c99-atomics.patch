# qwrt patch: force GCC/Clang __atomic_* builtins in quickjs-c-atomics.h so
# quickjs-ng compiles under -std=c99 (no C11 <stdatomic.h>).
# Base submodule: deps/quickjs-ng @ fd0a0210b7be00957751871e7e01b8291268fc29 (v0.15.1)
# Working-tree-only (the submodule stays clean); CMake re-applies when needed.
diff --git a/quickjs-c-atomics.h b/quickjs-c-atomics.h
index 8fc6b72..b552edd 100644
--- a/quickjs-c-atomics.h
+++ b/quickjs-c-atomics.h
@@ -22,11 +22,12 @@
  * THE SOFTWARE.
  */
 
-#if (defined(__GNUC__) || defined(__GNUG__)) && !defined(__clang__)
-   // Use GCC builtins for version < 4.9
-#  if((__GNUC__ << 16) + __GNUC_MINOR__ < ((4) << 16) + 9)
-#    define GCC_BUILTIN_ATOMICS
-#  endif
+/* qwrt: force GCC/Clang __atomic_* builtins so quickjs-ng compiles under C99
+ * (no <stdatomic.h>/C11 _Atomic keyword). __atomic_* builtins are available
+ * on GCC 4.7+ and Clang, so always use them on those compilers regardless of
+ * version. Patched by deps/quickjs-ng-c99-atomics.patch. */
+#if defined(__GNUC__) || defined(__clang__) || defined(__GNUG__)
+#  define GCC_BUILTIN_ATOMICS
 #endif
 
 #ifdef GCC_BUILTIN_ATOMICS
